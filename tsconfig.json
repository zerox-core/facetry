{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"],
  // src/views/Home.tsx 是上一代遗留首页：当前没有任何文件 import 它（不在 App.tsx 路由表中），
  // 且属于需求文档「不可变更」清单里的冻结页面，仍在使用已废除的旧阶段字面量（8 处 TS2367）。
  // 因此不纳入类型检查：它既不会被 Vite 打包，也不应为了类型清零而改动冻结文件。
  // 若要重新启用：先按 src/data.ts 的 STAGES 更新其阶段字面量，再从此处移除。
  "exclude": ["src/views/Home.tsx"]
}
