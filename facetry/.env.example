# FaceTry 人才招聘工作台 · 环境变量模板
# 使用方式：复制为 .env 并填写实际值；.env 已被 git 忽略，真实密钥不得提交版本库。
# 所有配置一律通过环境变量读取，代码中不得硬编码连接串、密钥、地址。

# ---- 服务 ----
APP_HOST=
APP_PORT=
APP_ENV=            # dev / prod
SECRET_KEY=         # 会话签名密钥
ENABLE_DEMO_LOGIN=  # true 时开放 /api/auth/demo 演示登录（仅限本地开发，生产不得设置）
BASE_PATH=          # 反向代理子路径（飞书 OAuth 回调地址拼接用，可空）

# ---- 业务库 MySQL ----
# MYSQL_HOST 为空时回退为 sqlite 文件 backend/data/facetry-dev.db（仅限开发便利）
# DATABASE_URL 非空时直接覆盖上述拼装（主要用于测试，如 sqlite:///./data/test.db）
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ---- 来源数据库（影刀落库，只读）----
SOURCE_DB_TYPE=     # mysql / mssql / postgresql ...
SOURCE_DB_HOST=
SOURCE_DB_PORT=
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
SOURCE_DB_DATABASE=

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false

# ---- 飞书应用（沿用现有应用，值不变）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=

# ---- 飞书审批 ----
FEISHU_APPROVAL_CODE=

# BPM 接入方式（接口 / 数据库 / 其他）尚未确定，确认后再补充对应环境变量

# ---- 通知通道（第三方服务，开发时提供短信/邮件模板）----
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# 约面邮件模板，占位符 {name}/{position}/{time}/{location}，留空用内置默认模板
MAIL_TEMPLATE_INTERVIEW=
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_INTERVIEW=   # 约面通知等模板 ID，按业务方提供的模板配置

# ---- LLM（OpenAI 兼容）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 管理员（同现有 config.json 语义）----
ADMIN_USERS=
SUPER_ADMIN_USERS=
