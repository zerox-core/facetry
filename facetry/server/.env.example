# LLM 配置：复制为 .env 并填入真实值（.env 已被 git 忽略）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# 飞书应用凭据（生产环境务必用环境变量注入，不要写入 config.json）
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=...
# FEISHU_REDIRECT_URI=https://<域名>/apps/zhangjintai-omrunk1w/api/auth/feishu/callback

# 数据库文件位置：平台固定注入 /data/app.db，无需设置；
# 本地开发不设置时默认 /data/app.db，可指向本地文件以保留既有数据
# SQLITE_PATH=./data/app.db

# 演示登录（/api/auth/demo）：仅限本地开发，生产环境切勿开启
# ENABLE_DEMO_LOGIN=true
